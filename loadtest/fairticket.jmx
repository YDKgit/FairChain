            <stringProp name="WhileController.condition">${__jexl3(&quot;${reserved}&quot; != &quot;true&quot; &amp;&amp; ${rtry} &lt; 5,)}</stringProp>
          </WhileController>
          <hashTree>
            <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="A-2 좌석 조회">
              <stringProp name="HTTPSampler.path">/api/concerts/${CONCERT}/seats</stringProp>
              <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
              <stringProp name="HTTPSampler.method">GET</stringProp>
              <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
              <boolProp name="HTTPSampler.postBodyRaw">false</boolProp>
              <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
                <collectionProp name="Arguments.arguments"/>
              </elementProp>
            </HTTPSamplerProxy>
            <hashTree>
              <UniformRandomTimer guiclass="UniformRandomTimerGui" testclass="UniformRandomTimer" testname="생각하는 시간" enabled="true">
                <stringProp name="ConstantTimer.delay">300</stringProp>
                <stringProp name="RandomTimer.range">700</stringProp>
              </UniformRandomTimer>
              <hashTree/>
              <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="좌석 고르기" enabled="true">
                <stringProp name="scriptLanguage">groovy</stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="script">// 예매 가능한 좌석 중 하나를 무작위로 고른다 (실제 사용자가 서로 다른 좌석을 누르는 것처럼). 없으면 매진으로 끝낸다
def seats = new groovy.json.JsonSlurper().parseText(prev.getResponseDataAsString()).seats
def empty = seats.findAll { it.status == &apos;EMPTY&apos; }
vars.put(&apos;rtry&apos;, ((vars.get(&apos;rtry&apos;) ?: &apos;0&apos;) as int) + 1 as String)
if (empty) {
    vars.put(&apos;seatId&apos;, empty[new Random().nextInt(empty.size())].seatId as String)
} else {
    vars.put(&apos;seatId&apos;, &apos;&apos;); vars.put(&apos;rtry&apos;, &apos;99&apos;)
    prev.setSampleLabel(prev.getSampleLabel() + &apos; — 매진이라 포기&apos;)
}</stringProp>
              </JSR223PostProcessor>
              <hashTree/>
            </hashTree>
            <IfController guiclass="IfControllerPanel" testclass="IfController" testname="고른 좌석이 있으면">
              <stringProp name="IfController.condition">${__jexl3(&quot;${seatId}&quot; != &quot;&quot;,)}</stringProp>
              <boolProp name="IfController.evaluateAll">false</boolProp>
              <boolProp name="IfController.useExpression">true</boolProp>
            </IfController>
            <hashTree>
              <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="A-3 예매">
                <stringProp name="HTTPSampler.path">/api/reservations</stringProp>
                <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
                <stringProp name="HTTPSampler.method">POST</stringProp>
                <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
                <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
                <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
                  <collectionProp name="Arguments.arguments">
                    <elementProp name="" elementType="HTTPArgument">
                      <boolProp name="HTTPArgument.always_encode">false</boolProp>
                      <stringProp name="Argument.value">{&quot;seatId&quot;:${seatId},&quot;concertId&quot;:${CONCERT}}</stringProp>
                      <stringProp name="Argument.metadata">=</stringProp>
                    </elementProp>
                  </collectionProp>
                </elementProp>
              </HTTPSamplerProxy>
              <hashTree>
                <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="예매 결과" enabled="true">
                  <stringProp name="scriptLanguage">groovy</stringProp>
                  <stringProp name="parameters"></stringProp>
                  <stringProp name="filename"></stringProp>
                  <stringProp name="cacheKey">true</stringProp>
                  <stringProp name="script">// 예매 결과: 성공이면 티켓 번호를 기억한다. 다른 사람이 먼저 잡은 좌석이면 정상적인 거절이므로 실패로 세지 않고 다시 고른다
def code = prev.getResponseCode()
def r = null
try { r = new groovy.json.JsonSlurper().parseText(prev.getResponseDataAsString()) } catch (e) { }
if (code == &apos;200&apos; &amp;&amp; r?.success) {
    vars.put(&apos;reserved&apos;, &apos;true&apos;); vars.put(&apos;ticketId&apos;, r.ticketId as String)
} else if (code == &apos;200&apos; &amp;&amp; r != null) {
    prev.setSampleLabel(prev.getSampleLabel() + &apos; — 선점 실패 (다시 고름)&apos;)
    prev.setSuccessful(true)
}</stringProp>
                </JSR223PostProcessor>
                <hashTree/>
              </hashTree>
            </hashTree>
          </hashTree>
          <IfController guiclass="IfControllerPanel" testclass="IfController" testname="예매 성공" enabled="true">
            <stringProp name="IfController.condition">${__jexl3(&quot;${reserved}&quot; == &quot;true&quot;,)}</stringProp>
            <boolProp name="IfController.evaluateAll">false</boolProp>
            <boolProp name="IfController.useExpression">true</boolProp>
          </IfController>
          <hashTree>
            <TransactionController guiclass="TransactionControllerGui" testclass="TransactionController" testname="A-4 예매 후 블록체인 검증 완료까지" enabled="true">
              <boolProp name="TransactionController.includeTimers">true</boolProp>
            </TransactionController>
            <hashTree>
              <WhileController guiclass="WhileControllerGui" testclass="WhileController" testname="검증 완료까지 확인 (최대 60초)" enabled="true">
                <stringProp name="WhileController.condition">${__jexl3(&quot;${vstate}&quot; != &quot;VERIFIED&quot; &amp;&amp; ${vtry} &lt; 120,)}</stringProp>
              </WhileController>
              <hashTree>
                <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="A-4 내 티켓 확인" enabled="true">
                  <stringProp name="HTTPSampler.path">/api/tickets/${ticketId}</stringProp>
                  <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
                  <stringProp name="HTTPSampler.method">GET</stringProp>
                  <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
                  <boolProp name="HTTPSampler.postBodyRaw">false</boolProp>
                  <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
                    <collectionProp name="Arguments.arguments"/>
                  </elementProp>
                </HTTPSamplerProxy>
                <hashTree>
                  <ConstantTimer guiclass="ConstantTimerGui" testclass="ConstantTimer" testname="500ms 쉬기" enabled="true">
                    <stringProp name="ConstantTimer.delay">500</stringProp>
                  </ConstantTimer>
                  <hashTree/>
                  <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="검증 상태 읽기" enabled="true">
                    <stringProp name="scriptLanguage">groovy</stringProp>
                    <stringProp name="parameters"></stringProp>
                    <stringProp name="filename"></stringProp>
                    <stringProp name="cacheKey">true</stringProp>
                    <stringProp name="script">def state = &apos;NONE&apos;
try { state = new groovy.json.JsonSlurper().parseText(prev.getResponseDataAsString()).verificationStatus ?: &apos;NONE&apos; } catch (e) { }
vars.put(&apos;vstate&apos;, state)
vars.put(&apos;vtry&apos;, ((vars.get(&apos;vtry&apos;) ?: &apos;0&apos;) as int) + 1 as String)</stringProp>
                  </JSR223PostProcessor>
                  <hashTree/>
                </hashTree>
              </hashTree>
            </hashTree>
          </hashTree>
        </hashTree>
      </hashTree>
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="C. 매크로 (한 회원의 반복 요청)">
        <stringProp name="TestPlan.comments">-JmacroUsers 명이 각자 -JmacroLoops 번 연속 요청</stringProp>
        <stringProp name="ThreadGroup.num_threads">${__P(macroUsers,1)}</stringProp>
        <intProp name="ThreadGroup.ramp_time">1</intProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller">
          <stringProp name="LoopController.loops">1</stringProp>
          <boolProp name="LoopController.continue_forever">false</boolProp>
        </elementProp>
      </ThreadGroup>
      <hashTree>
        <CookieManager guiclass="CookiePanel" testclass="CookieManager" testname="세션 쿠키 (스레드마다 따로)" enabled="true">
          <collectionProp name="CookieManager.cookies"/>
          <boolProp name="CookieManager.clearEachIteration">false</boolProp>
          <boolProp name="CookieManager.controlledByThreadGroup">false</boolProp>
        </CookieManager>
        <hashTree/>
        <TransactionController guiclass="TransactionControllerGui" testclass="TransactionController" testname="C-0 준비: 회원가입 + 로그인" enabled="true">
          <boolProp name="TransactionController.includeTimers">true</boolProp>
        </TransactionController>
        <hashTree>
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="C-0 회원가입" enabled="true">
            <stringProp name="HTTPSampler.path">/api/members</stringProp>
            <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
            <stringProp name="HTTPSampler.method">POST</stringProp>
            <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
            <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
            <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
              <collectionProp name="Arguments.arguments">
                <elementProp name="" elementType="HTTPArgument">
                  <boolProp name="HTTPArgument.always_encode">false</boolProp>
                  <stringProp name="Argument.value">{&quot;loginId&quot;:&quot;c${RUN}_${__threadNum}&quot;,&quot;password&quot;:&quot;load1234&quot;,&quot;name&quot;:&quot;부하c${__threadNum}&quot;,&quot;contact&quot;:&quot;010-0000-0000&quot;}</stringProp>
                  <stringProp name="Argument.metadata">=</stringProp>
                </elementProp>
              </collectionProp>
            </elementProp>
          </HTTPSamplerProxy>
          <hashTree/>
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="C-0 로그인" enabled="true">
            <stringProp name="HTTPSampler.path">/api/members/login</stringProp>
            <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
            <stringProp name="HTTPSampler.method">POST</stringProp>
            <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
            <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
            <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
              <collectionProp name="Arguments.arguments">
                <elementProp name="" elementType="HTTPArgument">
                  <boolProp name="HTTPArgument.always_encode">false</boolProp>
                  <stringProp name="Argument.value">{&quot;loginId&quot;:&quot;c${RUN}_${__threadNum}&quot;,&quot;password&quot;:&quot;load1234&quot;}</stringProp>
                  <stringProp name="Argument.metadata">=</stringProp>
                </elementProp>
              </collectionProp>
            </elementProp>
          </HTTPSamplerProxy>
