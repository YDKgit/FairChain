                </elementProp>
              </collectionProp>
            </elementProp>
          </HTTPSamplerProxy>
          <hashTree/>
        </hashTree>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="B-1 대기열 진입">
          <stringProp name="HTTPSampler.path">/api/queue/${CONCERT}</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
          <stringProp name="HTTPSampler.method">POST</stringProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
            <collectionProp name="Arguments.arguments">
              <elementProp name="" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">false</boolProp>
                <stringProp name="Argument.value">{}</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
              </elementProp>
            </collectionProp>
          </elementProp>
        </HTTPSamplerProxy>
        <hashTree>
          <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="변수 초기화" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">vars.put(&apos;qtry&apos;, &apos;0&apos;); vars.put(&apos;qfail&apos;, &apos;0&apos;); vars.put(&apos;qstate&apos;, &apos;NONE&apos;); vars.put(&apos;qnext&apos;, &apos;1000&apos;); vars.put(&apos;qwaited&apos;, &apos;0&apos;)
vars.put(&apos;qstart&apos;, System.currentTimeMillis() as String); vars.put(&apos;rtry&apos;, &apos;0&apos;); vars.put(&apos;reserved&apos;, &apos;false&apos;)
vars.put(&apos;seatId&apos;, &apos;&apos;); vars.put(&apos;ticketId&apos;, &apos;&apos;); vars.put(&apos;vtry&apos;, &apos;0&apos;); vars.put(&apos;vstate&apos;, &apos;NONE&apos;)</stringProp>
          </JSR223PreProcessor>
          <hashTree/>
          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="대기열 상태 읽기" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">// 대기열 응답에서 상태를 읽고, 이 뒤 단계에서 쓸 변수를 처음 값으로 맞춘다
def state = &apos;NONE&apos;
def next = null
try {
    def body = new groovy.json.JsonSlurper().parseText(prev.getResponseDataAsString())
    state = body.state ?: &apos;NONE&apos;
    next = body.nextPollMs
} catch (e) { }
vars.put(&apos;qstate&apos;, state)
// 다음 순번 확인까지 쉬는 시간: 실제 화면처럼 서버가 알려 준 간격(nextPollMs — 앞 순번 1초, 뒤 순번 최대 15초)을 따른다.
// -JpollMs=1000 처럼 주면 그 간격으로 고정한다 (간격을 지키지 않는 매크로 흉내 — 예제서버가 직전 답을 돌려주는지 볼 때)
def fixed = (props.getProperty(&apos;pollMs&apos;, &apos;0&apos;) as int)
vars.put(&apos;qnext&apos;, (fixed &gt; 0 ? fixed : (next ?: 1000)) as String)
vars.put(&apos;qtry&apos;, ((vars.get(&apos;qtry&apos;) ?: &apos;0&apos;) as int) + 1 as String)
// 줄에 선 뒤 지난 초 (-JqueueWait 비교용 — 확인 간격이 순번마다 달라 횟수로는 셀 수 없다)
vars.put(&apos;qwaited&apos;, ((System.currentTimeMillis() - ((vars.get(&apos;qstart&apos;) ?: &apos;0&apos;) as long)) / 1000) as long as String)
// 서버가 계속 실패로 답하면(죽었거나 공연이 없음) 끝없이 기다리지 않도록 연속 실패 횟수를 센다
