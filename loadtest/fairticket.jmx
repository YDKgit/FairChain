      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="B. 같은 좌석 동시 예매">
        <stringProp name="TestPlan.comments">-JraceUsers 명이 준비 단계에서 정한 좌석 하나를 동시에 예매</stringProp>
        <stringProp name="ThreadGroup.num_threads">${__P(raceUsers,20)}</stringProp>
        <intProp name="ThreadGroup.ramp_time">2</intProp>
