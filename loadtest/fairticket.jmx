        </hashTree>
        <LoopController guiclass="LoopControlPanel" testclass="LoopController" testname="쉬지 않고 반복" enabled="true">
          <boolProp name="LoopController.continue_forever">true</boolProp>
          <stringProp name="LoopController.loops">${__P(macroLoops,100)}</stringProp>
        </LoopController>
        <hashTree>
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="C-1 대기열 반복 요청" enabled="true">
            <stringProp name="HTTPSampler.path">/api/queue/${CONCERT}</stringProp>
            <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
            <stringProp name="HTTPSampler.method">POST</stringProp>
            <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
            <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
            <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
              <collectionProp name="Arguments.arguments">
                <elementProp name="" elementType="HTTPArgument">
                  <boolProp name="HTTPArgument.always_encode">false</boolProp>
                  <stringProp name="Argument.value">{}</stringProp>
                  <stringProp name="Argument.metadata">=</stringProp>
                </elementProp>
              </collectionProp>
            </elementProp>
          </HTTPSamplerProxy>
          <hashTree>
            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="차단 여부" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">// 한 회원이 쉬지 않고 요청하면 FairChain이 초당 한도(기본 5회)를 넘는 요청을 거절한다.
// 예제서버는 그 거절을 502 + &quot;요청이 너무 많습니다&quot;로 전달한다. 이 시나리오에서는 그 거절이 기대한 결과다
def body = prev.getResponseDataAsString()
if (prev.getResponseCode() == &apos;200&apos;) {
    prev.setSampleLabel(prev.getSampleLabel() + &apos; — 통과&apos;)
} else if (body.contains(&apos;요청이 너무 많습니다&apos;)) {
    prev.setSampleLabel(prev.getSampleLabel() + &apos; — 차단됨 (정상)&apos;)
    prev.setSuccessful(true)
}</stringProp>
            </JSR223PostProcessor>
            <hashTree/>
          </hashTree>
        </hashTree>
      </hashTree>
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="D. 둘러보기 (조회만)">
        <stringProp name="TestPlan.comments">-JbrowseUsers 명이 -JbrowseSeconds 초 동안 (기본 0명 = 건너뜀)</stringProp>
        <stringProp name="ThreadGroup.num_threads">${__P(browseUsers,0)}</stringProp>
        <intProp name="ThreadGroup.ramp_time">5</intProp>
        <stringProp name="ThreadGroup.duration">${__P(browseSeconds,30)}</stringProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
        <boolProp name="ThreadGroup.scheduler">true</boolProp>
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller">
          <intProp name="LoopController.loops">-1</intProp>
          <boolProp name="LoopController.continue_forever">false</boolProp>
        </elementProp>
      </ThreadGroup>
