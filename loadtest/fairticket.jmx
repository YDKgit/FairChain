      <PostThreadGroup guiclass="PostThreadGroupGui" testclass="PostThreadGroup" testname="판정">
        <intProp name="ThreadGroup.num_threads">1</intProp>
        <intProp name="ThreadGroup.ramp_time">1</intProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller">
          <stringProp name="LoopController.loops">1</stringProp>
          <boolProp name="LoopController.continue_forever">false</boolProp>
        </elementProp>
      </PostThreadGroup>
      <hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="B 판정" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">// 통과 기준: 같은 좌석에 성공한 사람이 정확히 1명
def wins = props.get(&apos;raceWins&apos;)?.get() ?: 0
def racers = props.getProperty(&apos;raceUsers&apos;, &apos;20&apos;) as int
SampleResult.setSampleLabel(&apos;B 판정: 같은 좌석 예매 성공 &apos; + wins + &apos;명 (기준 1명)&apos;)
SampleResult.setSuccessful(racers == 0 || wins == 1)
SampleResult.setResponseMessage(&apos;성공 &apos; + wins + &apos;명 / 시도 &apos; + racers + &apos;명&apos;)
SampleResult.setResponseData(&apos;성공 &apos; + wins + &apos;명 / 시도 &apos; + racers + &apos;명&apos;, &apos;UTF-8&apos;)</stringProp>
        </JSR223Sampler>
        <hashTree/>
      </hashTree>
      <ResultCollector guiclass="SummaryReport" testclass="ResultCollector" testname="요약 보고서 (GUI에서 볼 때)">
        <boolProp name="ResultCollector.error_logging">false</boolProp>
        <objProp>
          <name>saveConfig</name>
          <value class="SampleSaveConfiguration">
            <time>true</time>
            <latency>true</latency>
            <timestamp>true</timestamp>
            <success>true</success>
            <label>true</label>
            <code>true</code>
