vars.put('seatId', ''); vars.put('ticketId', ''); vars.put('vtry', '0'); vars.put('vstate', 'NONE')</stringProp></JSR223PreProcessor><hashTree/><JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="대기열 상태 읽기" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="parameters"></stringProp><stringProp name="filename"></stringProp><stringProp name="cacheKey">true</stringProp><stringProp name="script">// 대기열 응답에서 상태를 읽고, 이 뒤 단계에서 쓸 변수를 처음 값으로 맞춘다
def state = 'NONE'
try { state = new groovy.json.JsonSlurper().parseText(prev.getResponseDataAsString()).state ?: 'NONE' } catch (e) { }
vars.put('qstate', state)
vars.put('qtry', ((vars.get('qtry') ?: '0') as int) + 1 as String)</stringProp></JSR223PostProcessor><hashTree/></hashTree><WhileController guiclass="WhileControllerGui" testclass="WhileController" testname="A-1 입장 허용까지 대기" enabled="true"><stringProp name="WhileController.condition">${__jexl3("${qstate}" != "ADMITTED" &amp;&amp; ${qtry} &lt; 180,)}</stringProp></WhileController><hashTree><HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="A-1 대기 순번 확인" enabled="true"><boolProp name="HTTPSampler.postBodyRaw">false</boolProp><elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true"><collectionProp name="Arguments.arguments"></collectionProp></elementProp><stringProp name="HTTPSampler.path">/api/queue/${CONCERT}/status</stringProp><stringProp name="HTTPSampler.method">GET</stringProp><boolProp name="HTTPSampler.follow_redirects">true</boolProp><boolProp name="HTTPSampler.use_keepalive">true</boolProp></HTTPSamplerProxy><hashTree><ConstantTimer guiclass="ConstantTimerGui" testclass="ConstantTimer" testname="1000ms 쉬기" enabled="true"><stringProp name="ConstantTimer.delay">1000</stringProp></ConstantTimer><hashTree/><JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="대기열 상태 읽기" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="parameters"></stringProp><stringProp name="filename"></stringProp><stringProp name="cacheKey">true</stringProp><stringProp name="script">// 대기열 응답에서 상태를 읽고, 이 뒤 단계에서 쓸 변수를 처음 값으로 맞춘다
def state = 'NONE'
try { state = new groovy.json.JsonSlurper().parseText(prev.getResponseDataAsString()).state ?: 'NONE' } catch (e) { }
vars.put('qstate', state)
vars.put('qtry', ((vars.get('qtry') ?: '0') as int) + 1 as String)</stringProp></JSR223PostProcessor><hashTree/></hashTree></hashTree><IfController guiclass="IfControllerPanel" testclass="IfController" testname="입장 허용됨" enabled="true"><stringProp name="IfController.condition">${__jexl3("${qstate}" == "ADMITTED",)}</stringProp><boolProp name="IfController.evaluateAll">false</boolProp><boolProp name="IfController.useExpression">true</boolProp></IfController><hashTree><WhileController guiclass="WhileControllerGui" testclass="WhileController" testname="A-2 좌석 잡기 (최대 5번)" enabled="true"><stringProp name="WhileController.condition">${__jexl3("${reserved}" != "true" &amp;&amp; ${rtry} &lt; 5,)}</stringProp></WhileController><hashTree><HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="A-2 좌석 조회" enabled="true"><boolProp name="HTTPSampler.postBodyRaw">false</boolProp><elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true"><collectionProp name="Arguments.arguments"></collectionProp></elementProp><stringProp name="HTTPSampler.path">/api/concerts/${CONCERT}/seats</stringProp><stringProp name="HTTPSampler.method">GET</stringProp><boolProp name="HTTPSampler.follow_redirects">true</boolProp><boolProp name="HTTPSampler.use_keepalive">true</boolProp></HTTPSamplerProxy><hashTree><UniformRandomTimer guiclass="UniformRandomTimerGui" testclass="UniformRandomTimer" testname="생각하는 시간" enabled="true"><stringProp name="ConstantTimer.delay">300</stringProp><stringProp name="RandomTimer.range">700</stringProp></UniformRandomTimer><hashTree/><JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="좌석 고르기" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="parameters"></stringProp><stringProp name="filename"></stringProp><stringProp name="cacheKey">true</stringProp><stringProp name="script">// 예매 가능한 좌석 중 하나를 무작위로 고른다 (실제 사용자가 서로 다른 좌석을 누르는 것처럼). 없으면 매진으로 끝낸다
def seats = new groovy.json.JsonSlurper().parseText(prev.getResponseDataAsString()).seats
def empty = seats.findAll { it.status == 'EMPTY' }
vars.put('rtry', ((vars.get('rtry') ?: '0') as int) + 1 as String)
if (empty) {
    vars.put('seatId', empty[new Random().nextInt(empty.size())].seatId as String)
} else {
    vars.put('seatId', ''); vars.put('rtry', '99')
    prev.setSampleLabel(prev.getSampleLabel() + ' — 매진이라 포기')
}</stringProp></JSR223PostProcessor><hashTree/></hashTree><IfController guiclass="IfControllerPanel" testclass="IfController" testname="고른 좌석이 있으면" enabled="true"><stringProp name="IfController.condition">${__jexl3("${seatId}" != "",)}</stringProp><boolProp name="IfController.evaluateAll">false</boolProp><boolProp name="IfController.useExpression">true</boolProp></IfController><hashTree><HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="A-3 예매" enabled="true"><boolProp name="HTTPSampler.postBodyRaw">true</boolProp><elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true"><collectionProp name="Arguments.arguments"><elementProp name="" elementType="HTTPArgument"><boolProp name="HTTPArgument.always_encode">false</boolProp><stringProp name="Argument.value">{"seatId":${seatId},"concertId":${CONCERT}}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp></collectionProp></elementProp><stringProp name="HTTPSampler.path">/api/reservations</stringProp><stringProp name="HTTPSampler.method">POST</stringProp><boolProp name="HTTPSampler.follow_redirects">true</boolProp><boolProp name="HTTPSampler.use_keepalive">true</boolProp></HTTPSamplerProxy><hashTree><JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="예매 결과" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="parameters"></stringProp><stringProp name="filename"></stringProp><stringProp name="cacheKey">true</stringProp><stringProp name="script">// 예매 결과: 성공이면 티켓 번호를 기억한다. 다른 사람이 먼저 잡은 좌석이면 정상적인 거절이므로 실패로 세지 않고 다시 고른다
def code = prev.getResponseCode()
def r = null
try { r = new groovy.json.JsonSlurper().parseText(prev.getResponseDataAsString()) } catch (e) { }
if (code == '200' &amp;&amp; r?.success) {
    vars.put('reserved', 'true'); vars.put('ticketId', r.ticketId as String)
} else if (code == '200' &amp;&amp; r != null) {
    prev.setSampleLabel(prev.getSampleLabel() + ' — 선점 실패 (다시 고름)')
    prev.setSuccessful(true)
}</stringProp></JSR223PostProcessor><hashTree/></hashTree></hashTree></hashTree><IfController guiclass="IfControllerPanel" testclass="IfController" testname="예매 성공" enabled="true"><stringProp name="IfController.condition">${__jexl3("${reserved}" == "true",)}</stringProp><boolProp name="IfController.evaluateAll">false</boolProp><boolProp name="IfController.useExpression">true</boolProp></IfController><hashTree><TransactionController guiclass="TransactionControllerGui" testclass="TransactionController" testname="A-4 예매 후 블록체인 검증 완료까지" enabled="true"><boolProp name="TransactionController.includeTimers">true</boolProp><boolProp name="TransactionController.parent">false</boolProp></TransactionController><hashTree><WhileController guiclass="WhileControllerGui" testclass="WhileController" testname="검증 완료까지 확인 (최대 60초)" enabled="true"><stringProp name="WhileController.condition">${__jexl3("${vstate}" != "VERIFIED" &amp;&amp; ${vtry} &lt; 120,)}</stringProp></WhileController><hashTree><HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="A-4 내 티켓 확인" enabled="true"><boolProp name="HTTPSampler.postBodyRaw">false</boolProp><elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true"><collectionProp name="Arguments.arguments"></collectionProp></elementProp><stringProp name="HTTPSampler.path">/api/tickets/${ticketId}</stringProp><stringProp name="HTTPSampler.method">GET</stringProp><boolProp name="HTTPSampler.follow_redirects">true</boolProp><boolProp name="HTTPSampler.use_keepalive">true</boolProp></HTTPSamplerProxy><hashTree><ConstantTimer guiclass="ConstantTimerGui" testclass="ConstantTimer" testname="500ms 쉬기" enabled="true"><stringProp name="ConstantTimer.delay">500</stringProp></ConstantTimer><hashTree/><JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="검증 상태 읽기" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="parameters"></stringProp><stringProp name="filename"></stringProp><stringProp name="cacheKey">true</stringProp><stringProp name="script">def state = 'NONE'
