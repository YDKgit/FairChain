        <hashTree/>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="준비 공연 확인" enabled="true">
          <stringProp name="HTTPSampler.path">/api/concerts/${CONCERT}</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
          <stringProp name="HTTPSampler.method">GET</stringProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          <boolProp name="HTTPSampler.postBodyRaw">false</boolProp>
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
            <collectionProp name="Arguments.arguments"/>
          </elementProp>
        </HTTPSamplerProxy>
        <hashTree>
          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="모자란 좌석 계산" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">// 좌석이 모자라면 한 줄에 20석씩 새 줄을 만들어 등록 요청 본문을 만든다.
// 줄 이름은 L + 글자(LA, LB, …)이고 지금 좌석 수에서 번호를 시작해서, 이미 있는 줄이나 앞선 실행의 줄과 겹치지 않는다
def concert = new groovy.json.JsonSlurper().parseText(prev.getResponseDataAsString())
def need = (props.getProperty(&apos;seats&apos;, &apos;150&apos;) as int) - (concert.emptySeats as int)
vars.put(&apos;gradeId&apos;, concert.seatGrades[0].id as String)
vars.put(&apos;needSeats&apos;, Math.max(0, need) as String)
def rowName = { int i -&gt; def s = &apos;&apos;; i++; while (i &gt; 0) { i--; s = String.valueOf((char) (65 + i % 26)) + s; i = i.intdiv(26) }; s }
def firstRow = concert.totalSeats as int
def ranges = []
for (int k = 0; k * 20 &lt; need; k++) { def r = &apos;L&apos; + rowName(firstRow + k); ranges &lt;&lt; &apos;&quot;&apos; + r + &apos;1-&apos; + r + Math.min(20, need - k * 20) + &apos;&quot;&apos; }
vars.put(&apos;seatRanges&apos;, ranges.join(&apos;,&apos;))
if (!concert.open) { prev.setSuccessful(false); prev.setResponseMessage(&apos;이 공연은 아직 예매 오픈 전이라 시나리오를 돌릴 수 없습니다 — concertId를 바꾸세요&apos;) }</stringProp>
          </JSR223PostProcessor>
          <hashTree/>
        </hashTree>
        <IfController guiclass="IfControllerPanel" testclass="IfController" testname="좌석이 모자라면 등록" enabled="true">
          <stringProp name="IfController.condition">${__jexl3(${needSeats} &gt; 0,)}</stringProp>
          <boolProp name="IfController.evaluateAll">false</boolProp>
          <boolProp name="IfController.useExpression">true</boolProp>
        </IfController>
        <hashTree>
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="준비 좌석 등록 (좌석마다 FairChain 발행 기록)" enabled="true">
            <intProp name="HTTPSampler.response_timeout">180000</intProp>
            <stringProp name="HTTPSampler.path">/api/operator/seats</stringProp>
            <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
            <stringProp name="HTTPSampler.method">POST</stringProp>
            <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
            <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
            <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
              <collectionProp name="Arguments.arguments">
                <elementProp name="" elementType="HTTPArgument">
                  <boolProp name="HTTPArgument.always_encode">false</boolProp>
                  <stringProp name="Argument.value">{&quot;concertId&quot;:${CONCERT},&quot;seatGradeId&quot;:${gradeId},&quot;seatNumbers&quot;:[${seatRanges}]}</stringProp>
                  <stringProp name="Argument.metadata">=</stringProp>
                </elementProp>
              </collectionProp>
            </elementProp>
          </HTTPSamplerProxy>
          <hashTree/>
        </hashTree>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="준비 좌석 목록" enabled="true">
          <stringProp name="HTTPSampler.path">/api/concerts/${CONCERT}/seats</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
          <stringProp name="HTTPSampler.method">GET</stringProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          <boolProp name="HTTPSampler.postBodyRaw">false</boolProp>
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
            <collectionProp name="Arguments.arguments"/>
          </elementProp>
        </HTTPSamplerProxy>
        <hashTree>
          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="경합 좌석 정하기" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">// 시나리오 B에서 모두가 동시에 노릴 좌석 하나를 정해 둔다 (예매 가능한 첫 좌석)
def seats = new groovy.json.JsonSlurper().parseText(prev.getResponseDataAsString()).seats
def empty = seats.findAll { it.status == &apos;EMPTY&apos; }
props.put(&apos;raceSeatId&apos;, empty ? empty[0].seatId as String : &apos;&apos;)
props.put(&apos;raceWins&apos;, new java.util.concurrent.atomic.AtomicInteger(0))
log.info(&apos;준비 끝: 예매 가능 좌석 &apos; + empty.size() + &apos;석, 경합 좌석 ID &apos; + props.get(&apos;raceSeatId&apos;))
if (!empty) { prev.setSuccessful(false); prev.setResponseMessage(&apos;예매 가능한 좌석이 없습니다&apos;) }</stringProp>
          </JSR223PostProcessor>
          <hashTree/>
        </hashTree>
      </hashTree>
      <SetupThreadGroup guiclass="SetupThreadGroupGui" testclass="SetupThreadGroup" testname="준비: A 회원 미리 만들기">
        <stringProp name="TestPlan.comments">-Jusers 명의 회원을 미리 가입시킨다 (A는 로그인만 한다)</stringProp>
